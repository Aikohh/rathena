# Copy to .env and edit. The file is optional: without it every setting below
# falls back to the default shown, which is what a fresh clone uses.
#
#   cp .env.example .env
#
# .env is gitignored, so these stay local to this machine. SECRETS DO NOT GO
# HERE - the password peppers live in secrets.age (devenv tasks run
# rathena:peppers). Interserver credentials are generated in conf/import/;
# the database password and allocated port live under .devenv/state/.

# --- connection -------------------------------------------------------------
# The address clients connect to. "auto" detects the WAN IP once, on the first
# start. Applied by: devenv tasks run rathena:configure
#RATHENA_PUBLIC_IP=1.2.3.4

# Shown in the client's server list. No spaces - guild emblems break.
#RATHENA_SERVER_NAME=rAthena

# --- build ------------------------------------------------------------------
# Client packet version. Compile time: changing it forces a clean rebuild.
#RATHENA_PACKETVER=20250716

# --- automatic backups ------------------------------------------------------
# Seconds between dumps while 'devenv up' is running. 0 turns them off;
# devenv tasks run rathena:backup still works by hand.
#RATHENA_BACKUP_INTERVAL=3600

# How many dumps to keep. Older ones are deleted after each run.
#RATHENA_BACKUP_KEEP=24

# Where to write them.
#RATHENA_BACKUP_DIR=backups

# age public key to encrypt backups to. Defaults to the recipient of
# ~/.config/secretspec/age-identity.txt when that exists. With neither,
# backups are written unencrypted.
#RATHENA_BACKUP_RECIPIENT=age1...

# Require clients to use <passwordencrypt>. Only set this if every client is
# configured for it: all cleartext login packets are refused. Existing argon2id
# accounts need `./rathena passwd ACCOUNT` or `--enroll` after enabling it.
# The wire pepper itself comes from secretspec (RATHENA_WIRE_PEPPER).
#RATHENA_WIRE_PEPPER_ENABLE=1
